#!/usr/bin/env python3
"""./merge seed/out/*.json  -- merge seed output into libretti.json (idempotent)."""
import json, sys
import data
entries = data.load()
for path in sys.argv[1:]:
    with open(path, encoding="utf-8") as f:
        new = json.load(f)
    a, u = data.merge(entries, new)
    print(f"{path}: {len(new)} entries, {a} added, {u} updated")
data.save(entries)
print(f"{len(entries)} total")
